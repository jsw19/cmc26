{
  "expo": {
    "name": "CheckMyCar",
    "slug": "checkmycar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "checkmycar",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f0f"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.checkmycar.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "CheckMyCar uses the camera to photograph your vehicle for damage analysis.",
        "NSPhotoLibraryUsageDescription": "CheckMyCar accesses your photo library to analyze vehicle images.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0f0f0f"
      },
      "package": "com.ashen728.checkmycar",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "CheckMyCar uses the camera to photograph your vehicle for damage analysis.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CheckMyCar accesses your photo library to analyze vehicle images."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e34f1cce-19b8-47d1-b1de-19c508ef1f41"
      }
    }
  }
}
